{{define "schema-definition" -}}

// {{ .Name }} is a schema from the AsyncAPI specification required in messages
{{if .Description -}}
// Description: {{multiLineComment .Description}}
{{end -}}

{{- /* ----------------------------- Object ----------------------------- */ -}}
{{- if eq .Type "object" -}}

type {{ namify .Name }} struct {
    {{- range $key, $value := .Properties -}}
    {{if $value.Description}}
    // Description: {{multiLineComment $value.Description}}
    {{else if and $value.ReferenceTo $value.ReferenceTo.Description}}
    // Description: {{multiLineComment $value.ReferenceTo.Description}}
    {{end -}}
    {{if $value.ExtGoName}}{{namify $value.ExtGoName}}{{else}}{{namify $key}}{{end}} {{if isFieldPointer $ $key $value }}*{{end}}{{template "schema-name" $value}} `{{generateJSONTags $value.Validations $key}}{{generateValidateTags $value.Validations (isFieldPointer $ $key $value) $value.Type }}`
    {{end -}}

    {{- if .AdditionalProperties}}
    // AdditionalProperties represents the object additional properties.
    AdditionalProperties map[string]{{template "schema-name" .AdditionalProperties}} `json:"-"`
    {{end -}}
}

{{- /* Override JSON marshalling in case there is additional properties */ -}}
{{- if .AdditionalProperties}}
    {{template "marshaling-additional-properties" .}}
{{- end}}

{{- /* Generate SetDefaults() for optional properties that have a default (#138) */ -}}
{{- $hasDefaults := false -}}
{{- range $key, $value := .Properties -}}
{{- if and (isFieldPointer $ $key $value) (hasScalarDefault $value) -}}{{- $hasDefaults = true -}}{{- end -}}
{{- end -}}
{{- if $hasDefaults}}

// SetDefaults sets the default values defined in the AsyncAPI specification for
// the optional fields that are not set.
func (t *{{ namify .Name }}) SetDefaults() {
{{- range $key, $value := .Properties}}
{{- if and (isFieldPointer $ $key $value) (hasScalarDefault $value)}}
    if t.{{if $value.ExtGoName}}{{namify $value.ExtGoName}}{{else}}{{namify $key}}{{end}} == nil {
        v := {{defaultLiteral $value}}
        t.{{if $value.ExtGoName}}{{namify $value.ExtGoName}}{{else}}{{namify $key}}{{end}} = &v
    }
{{- end}}
{{- end}}
}
{{- end}}

{{- /* ----------------------------- Others ----------------------------- */ -}}
{{- else -}}

type {{ .Name }} {{template "schema-name" .}}

{{/* Create specific marshaling for time */ -}}
{{- if isDateOrDateTimeGenerated .Format -}}
    {{template "marshaling-time" .}}
{{- end -}}

{{/* Create specific marshaling for oneOf */ -}}
{{- if .OneOf -}}
    {{template "marshaling-oneof" .}}
{{- end -}}

{{- end -}}

{{- /* ------------------------- SubDefinitions ------------------------- */ -}}
{{ if or (eq .Type "object") (eq .Type "array") -}}
    {{- range $key, $value := getChildrenObjectSchemas . }}
        {{template "schema-definition" $value }}
    {{- end}}
{{- end}}

{{- end -}}
